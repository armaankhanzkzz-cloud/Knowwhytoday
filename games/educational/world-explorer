}
function country(i){
let c=countries[i];
app.innerHTML=`<div class='info'>
<h2>${c[0]} ${c[1]}</h2>
<p>Capital: ${c[2]}</p>
<p>Currency: ${c[3]}</p>
<p>Region: ${c[5]}</p><p>Explore this country's geography and culture.</p>

<button onclick="exploreCountries()">Back</button>
</div>`;
}

function showPlaces(){
app.innerHTML="<h2>Famous Places</h2><div class='places'>"+
countries.map(c=>`<div class='card'><h3>${c[4]}</h3><p>${c[1]}</p></div>`).join("")+"</div>";
}

function startQuiz(m){
mode=m;current=0;
resetLevelScore(); questions=[...new Map(countries.map(c=>[c[1],c])).values()].sort(()=>Math.random()-0.5).slice(0,Math.min(20,countries.length));
showQuestion();
}

function showQuestion(){
let c=questions[current];
let type=mode==="random"?["flag","capital","currency"][Math.floor(Math.random()*3)]:mode;
let q="",answer="";
if(type==="flag"){q=`Which country has this flag? ${c[0]}`;answer=c[1]}
if(type==="capital"){q=`What is the capital of ${c[1]}?`;answer=c[2]}
if(type==="currency"){q=`What currency is used in ${c[1]}?`;answer=c[3]}
let opts=[answer];
while(opts.length<4){let x=countries[Math.floor(Math.random()*countries.length)];let v=type==="flag"?x[1]:type==="capital"?x[2]:x[3];if(!opts.includes(v))opts.push(v)}
opts.sort(()=>Math.random()-0.5);

app.innerHTML=`<div class='quiz'><h2>Question ${current+1}/${questions.length}</h2><h3>${q}</h3>
${opts.map(o=>`<button class="option" onclick="check(this,'${o}','${answer}')">${o}</button>`).join("")}
<p id='feedback'></p>
<button id="nextBtn" onclick="nextQuestion()" style="display:none">Next Question →</button>
</div>`;
}

function check(btn,choice,answer){
document.querySelectorAll(".quiz button.option").forEach(b=>b.disabled=true);

if(choice===answer){
btn.classList.add("correct");
score+=10;
feedback.innerHTML="Correct! +10 points";
}else{
btn.classList.add("wrong");
document.querySelectorAll(".quiz button.option").forEach(b=>{
if(b.textContent===answer)b.classList.add("correct");
});
feedback.innerHTML="";
}

updateScore();

document.getElementById("nextBtn").style.display="block";
}

function nextQuestion(){
current++;
if(current<questions.length){
showQuestion();
}else{
finish();
}
}

function finish(){
app.innerHTML=`<div class='quiz'><h2>Round Complete</h2><h3>Score: ${score}</h3><button onclick="startQuiz(mode)">Play Again</button></div>`;
}

function filterCountries(){
let term=document.getElementById('countrySearch').value.toLowerCase();
document.querySelectorAll('.card').forEach(card=>{
if(card.parentElement.classList.contains('countries')){
card.style.display=card.innerText.toLowerCase().includes(term)?'block':'none';
}
});
}

let activeContinent="All";

function disabledFilterContinent(continent){
activeContinent=continent;
let list=continent==="All"?countries:countries.filter(c=>c[5]===continent);

app.innerHTML="<h2>Countries</h2><p id='countryCount'></p><p>Total countries available: ${countries.length}</p><div class='countries'>"+
list.map((c,i)=>`<div class="flip-card" onclick="flipCountryCard(this)">
<div class="flip-card-inner">
<div class="flip-front card">
<h2>${c[0]}</h2>
<b>${c[1]}</b>
<p>Tap to see details</p>
</div>
<div class="flip-back card">
<h3>${c[0]} ${c[1]}</h3>
<p><b>Capital:</b> ${c[2]}</p>
<p><b>Currency:</b> ${c[3]}</p>
<p><b>Continent:</b> ${c[5]}</p>
</div>
</div>
</div>`).join("")
+"</div>";
}


function countryFlipHandler(){
    document.querySelectorAll('.flip-card').forEach(function(card){
        card.addEventListener('click', function(){
            this.classList.toggle('flipped');
        });
    });
}
setTimeout(countryFlipHandler,100);
</script>
