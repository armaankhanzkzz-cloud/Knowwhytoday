<style>
:root{--navy:#101b2d;--gold:#c99a35;--bg:#fbfbf9}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);font-family:Arial;color:#172236}
header,footer{background:var(--navy);color:white;text-align:center;padding:25px}
.container{max-width:1100px;margin:auto;padding:25px}
h1,h2{font-family:Georgia}
.score{position:fixed;top:15px;right:15px;background:white;padding:12px;border-radius:10px;box-shadow:0 4px 15px #0002;color:var(--gold);font-weight:bold;z-index:5}
.menu,.countries,.places{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}
.card,.quiz{background:white;border:1px solid #ddd;border-radius:12px;padding:18px}
.card{cursor:pointer;text-align:center}
button{background:var(--navy);color:white;border:0;padding:12px;border-radius:8px;width:100%;margin:6px 0;cursor:pointer}
.correct{background:#2e9d4d!important}
.wrong{background:#c0392b!important}
.info{background:white;border-radius:12px;padding:20px;margin-top:20px}
@media(max-width:800px){.menu,.countries,.places{grid-template-columns:repeat(2,1fr)}}
@media(max-width:500px){.menu,.countries,.places{grid-template-columns:1fr}}

.country-card{perspective:1000px;cursor:pointer}
.country-inner{transition:.5s;transform-style:preserve-3d;position:relative}
.country-card.flip .country-inner{transform:rotateY(180deg)}
.country-front,.country-back{backface-visibility:hidden}
.country-back{transform:rotateY(180deg);position:absolute;inset:0}

.flip-card{overflow:hidden;perspective:1000px;cursor:pointer;min-height:180px;}
.flip-card-inner{position:relative;width:100%;min-height:180px;transition:transform .6s;transform-style:preserve-3d;}
.flip-card.flipped .flip-card-inner{transform:rotateY(180deg);}
.flip-front,.flip-back{position:absolute;width:100%;min-height:180px;backface-visibility:hidden;}
.flip-back{transform:rotateY(180deg);}

.flip-card{
perspective:1000px;
cursor:pointer;
height:200px;
}
.flip-inner{
height:100%;
