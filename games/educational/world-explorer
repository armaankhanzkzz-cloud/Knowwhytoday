function countryPopularityRank(name){
    let index=countryPopularityOrder.indexOf(name);
    return index===-1 ? 999 : index;
}

function exploreCountries(){

    let uniqueCountries=[...new Map(countries.map(c=>[c[1],c])).values()].sort((a,b)=>countryPopularityRank(a[1])-countryPopularityRank(b[1]));
